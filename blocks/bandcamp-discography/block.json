{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mds-bandcamp/bandcamp-discography",
	"textdomain": "mds-bandcamp-integration",
	"title": "Bandcamp Discography",
	"description": "Embed an entire Bandcamp discography via URL",
	"keywords": ["bandcamp", "embed", "releases", "albums", "discography"],
	"category": "mds-release-manager",
	"icon": "album",
	"supports": {
		"html": false,
		"anchor": true,
		"align": ["wide", "full"],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"attributes": {
		"previewMode": { "type": "boolean", "default": true },
		"artistId": { "type": "number", "default": 0 },
		"artist_url": { "type": "string", "default": "" },
		"blockID": { "type": "string", "default": "" },
		"text_color": { "type": "string" },
		"button_color": { "type": "string" },
		"button_text_color": { "type": "string" },
		"release_border": { "type": "object" },
		"release_image_padding": { "type": "object" },
		"release_titles_padding": { "type": "object" },
		"release_titles_align": { "type": "string" },
		"display_album_art": { "type": "boolean" },
		"display_album_artist": { "type": "boolean" },
		"display_album_link": { "type": "boolean" },
		"display_album_title": { "type": "boolean" },
		"layout_grid_gap": { "type": "string" },
		"layout_columns": { "type": "number" },
		"layout_columns_mobile": { "type": "number" }
	},
	"editorScript": "file:./index.js",
	"style": "file:./frontend.css",
	"render": "file:./render.php"
}
