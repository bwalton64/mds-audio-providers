{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mds-bandcamp/bandcamp-album",
	"textdomain": "mds-bandcamp-integration",
	"title": "Bandcamp Album",
	"description": "Embed a Bandcamp featured album section via URL",
	"keywords": ["bandcamp", "embed", "featured", "album", "player"],
	"category": "mds-release-manager",
	"icon": "album",
	"supports": {
		"html": false,
		"anchor": true,
		"align": ["wide", "full"],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"attributes": {
		"previewMode": { "type": "boolean", "default": true },
		"url": { "type": "string", "default": "" },
		"albumID": { "type": "string", "default": "" },
		"blockID": { "type": "string", "default": "" },
		"backgroundColor": { "type": "string" },
		"textColor": { "type": "string" },
		"buttonColor": { "type": "string" },
		"trackColor": { "type": "string" },
		"playerControlsColor": { "type": "string" },
		"progressBarColor": { "type": "string" },
		"embedType": { "type": "string" },
		"display_album_art": { "type": "boolean" },
		"display_album_artist": { "type": "boolean" },
		"display_album_link": { "type": "boolean" },
		"display_album_title": { "type": "boolean" },
		"display_audio": { "type": "boolean" },
		"display_merch": { "type": "boolean" },
		"display_playlist": { "type": "boolean" }
	},
	"editorScript": "file:./index.js",
	"style": "file:./frontend.css",
	"viewScript": "file:./frontend.js",
	"render": "file:./render.php"
}
