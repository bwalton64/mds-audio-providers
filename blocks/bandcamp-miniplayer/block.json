{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mds-bandcamp/bandcamp-miniplayer",
	"textdomain": "mds-bandcamp-integration",
	"title": "Bandcamp Miniplayer",
	"description": "Embed a Bandcamp track mini player via URL",
	"keywords": ["bandcamp", "embed", "mini", "audio", "player"],
	"category": "mds-release-manager",
	"icon": "album",
	"supports": {
		"html": false,
		"anchor": true,
		"align": ["wide", "full"],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"attributes": {
		"previewMode": { "type": "boolean", "default": true },
		"url": { "type": "string", "default": "" },
		"albumID": { "type": "string", "default": "" },
		"blockID": { "type": "string", "default": "" },
		"artOpacity": { "type": "number" },
		"artOpacityHover": { "type": "number" },
		"aspectRatioHeight": { "type": "string" },
		"aspectRatioWidth": { "type": "string" },
		"backgroundColor": { "type": "string" },
		"buttonColor": { "type": "string" },
		"progressBarColor": { "type": "string" },
		"textColor": { "type": "string" },
		"trackNumber": { "type": "string" },
		"display_album_artist": { "type": "boolean" },
		"display_album_link": { "type": "boolean" },
		"display_album_title": { "type": "boolean" },
		"display_progress_bar": { "type": "boolean" },
		"display_track_title": { "type": "boolean" }
	},
	"editorScript": "file:./index.js",
	"style": "file:./frontend.css",
	"viewScript": "file:./frontend.js",
	"render": "file:./render.php"
}
